<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:paddingHorizontal="@dimen/auth_screen_horizontal_padding">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/auth_back_button_touch_size"
        android:layout_height="@dimen/auth_back_button_touch_size"
        android:layout_marginStart="@dimen/auth_back_button_start_margin"
        android:layout_marginTop="@dimen/auth_back_button_top_margin"
        android:background="@android:color/transparent"
        android:contentDescription="@string/auth_back"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_title_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_login_title"
        android:textColor="@color/auth_text_primary"
        android:textSize="@dimen/auth_title_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <EditText
        android:id="@+id/etEmail"
        style="@style/AuthEditTextStyle"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/auth_login_first_input_top_margin"
        android:autofillHints="emailAddress"
        android:hint="@string/auth_email_hint"
        android:inputType="textEmailAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/passwordInputContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_input_height"
        android:layout_marginTop="@dimen/auth_input_between_margin"
        android:background="@drawable/bg_auth_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etEmail">

        <EditText
            android:id="@+id/etPassword"
            style="@style/AuthPasswordInnerEditTextStyle"
            android:layout_width="0dp"
            android:autofillHints="password"
            android:hint="@string/auth_password_hint"
            android:inputType="textPassword"
            android:paddingStart="@dimen/auth_input_horizontal_padding"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnTogglePasswordVisibility"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnTogglePasswordVisibility"
            android:layout_width="@dimen/auth_password_icon_touch_size"
            android:layout_height="@dimen/auth_password_icon_touch_size"
            android:layout_marginEnd="@dimen/auth_password_icon_end_margin"
            android:background="@android:color/transparent"
            android:contentDescription="@string/auth_password_visibility_toggle"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_visibility_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_error_text_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_error_invalid_credentials"
        android:textColor="@color/auth_error_red"
        android:textSize="@dimen/auth_error_text_size"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/passwordInputContainer"
        app:layout_constraintTop_toBottomOf="@id/passwordInputContainer" />

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_login_forgot_top_margin"
        android:clickable="true"
        android:focusable="true"
        android:includeFontPadding="false"
        android:text="@string/auth_forgot_password"
        android:textColor="@color/auth_text_secondary"
        android:textSize="@dimen/auth_forgot_password_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPasswordError"
        app:layout_goneMarginTop="@dimen/auth_login_forgot_top_margin" />

    <TextView
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginTop="@dimen/auth_login_button_top_margin"
        android:background="@drawable/bg_auth_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/auth_login"
        android:textColor="@color/auth_text_primary"
        android:textSize="@dimen/auth_button_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvForgotPassword" />

    <LinearLayout
        android:id="@+id/loginDivider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_login_divider_top_margin"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLogin">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/auth_input_stroke" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_login_divider_text_margin"
            android:layout_marginEnd="@dimen/auth_login_divider_text_margin"
            android:includeFontPadding="false"
            android:text="@string/auth_login_with_google"
            android:textColor="@color/auth_text_secondary"
            android:textSize="@dimen/auth_login_divider_text_size" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/auth_input_stroke" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnGoogleLogin"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginTop="@dimen/auth_login_google_button_top_margin"
        android:background="@drawable/bg_auth_secondary_button"
        android:clickable="true"
        android:contentDescription="@string/auth_google_login"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_google"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginDivider" />

    <LinearLayout
        android:id="@+id/signupPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auth_login_signup_bottom_margin"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSignupPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/auth_signup_prompt"
            android:textColor="@color/auth_text_secondary"
            android:textSize="@dimen/auth_signup_prompt_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSignupLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/auth_signup_prompt_gap"
            android:text="@string/auth_signup_cta"
            android:textColor="@color/auth_brand_green"
            android:textSize="@dimen/auth_signup_prompt_text_size"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
