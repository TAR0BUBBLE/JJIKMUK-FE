<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:paddingHorizontal="@dimen/auth_screen_horizontal_padding">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/auth_back_button_touch_size"
        android:layout_height="@dimen/auth_back_button_touch_size"
        android:layout_marginStart="@dimen/auth_back_button_start_margin"
        android:layout_marginTop="@dimen/auth_back_button_top_margin"
        android:background="@android:color/transparent"
        android:contentDescription="@string/auth_back"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_title_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_otp_title"
        android:textColor="@color/auth_text_primary"
        android:textSize="@dimen/auth_title_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_description_top_margin"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/auth_otp_description"
        android:textColor="@color/auth_text_secondary"
        android:textSize="@dimen/auth_description_text_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <LinearLayout
        android:id="@+id/otpInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_input_top_margin"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription">

        <EditText
            android:id="@+id/etOtp1"
            android:layout_width="@dimen/auth_otp_box_width"
            android:layout_height="@dimen/auth_otp_box_height"
            android:autofillHints="oneTimeCode"
            android:background="@drawable/bg_auth_otp_active"
            android:gravity="center"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="@dimen/auth_otp_text_size"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp2"
            android:layout_width="@dimen/auth_otp_box_width"
            android:layout_height="@dimen/auth_otp_box_height"
            android:layout_marginStart="@dimen/auth_otp_box_gap"
            android:background="@drawable/bg_auth_otp_inactive"
            android:gravity="center"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="@dimen/auth_otp_text_size"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp3"
            android:layout_width="@dimen/auth_otp_box_width"
            android:layout_height="@dimen/auth_otp_box_height"
            android:layout_marginStart="@dimen/auth_otp_box_gap"
            android:background="@drawable/bg_auth_otp_inactive"
            android:gravity="center"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="@dimen/auth_otp_text_size"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp4"
            android:layout_width="@dimen/auth_otp_box_width"
            android:layout_height="@dimen/auth_otp_box_height"
            android:layout_marginStart="@dimen/auth_otp_box_gap"
            android:background="@drawable/bg_auth_otp_inactive"
            android:gravity="center"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="@dimen/auth_otp_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvOtpError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_otp_error_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_otp_error_invalid_code"
        android:textColor="@color/auth_error_red"
        android:textSize="@dimen/auth_error_text_size"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/otpInputContainer"
        app:layout_constraintTop_toBottomOf="@id/otpInputContainer" />

    <LinearLayout
        android:id="@+id/otpTimerContainer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auth_otp_timer_height"
        android:layout_marginTop="@dimen/auth_otp_timer_top_margin"
        android:background="@drawable/bg_auth_otp_timer"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/auth_otp_timer_horizontal_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOtpError">

        <TextView
            android:id="@+id/tvOtpTimerLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/auth_otp_timer_prefix"
            android:textColor="@color/auth_text_secondary"
            android:textSize="@dimen/auth_otp_timer_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOtpTimerValue"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/auth_otp_timer_text_gap"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="03:00"
            android:textColor="@color/auth_otp_timer_green"
            android:textSize="@dimen/auth_otp_timer_value_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvResendCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auth_otp_resend_bottom_margin"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/auth_otp_resend_text"
        android:textColor="@color/auth_text_secondary"
        android:textSize="@dimen/auth_otp_resend_text_size"
        app:layout_constraintBottom_toTopOf="@id/btnVerify"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnVerify"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginBottom="@dimen/auth_button_bottom_margin"
        android:background="@drawable/bg_auth_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/auth_verify"
        android:textColor="@color/auth_text_primary"
        android:textSize="@dimen/auth_button_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>