<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:paddingHorizontal="@dimen/auth_screen_horizontal_padding">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/auth_back_button_touch_size"
        android:layout_height="@dimen/auth_back_button_touch_size"
        android:layout_marginStart="@dimen/auth_back_button_start_margin"
        android:layout_marginTop="@dimen/auth_back_button_top_margin"
        android:background="@android:color/transparent"
        android:contentDescription="@string/auth_back"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_title_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_create_password_title"
        android:textColor="@color/auth_text_primary"
        android:textSize="@dimen/auth_title_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_description_top_margin"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/auth_create_password_description"
        android:textColor="@color/auth_text_secondary"
        android:textSize="@dimen/auth_description_text_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <EditText
        android:id="@+id/etNewPassword"
        style="@style/AuthEditTextStyle"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/auth_input_top_margin"
        android:autofillHints="newPassword"
        android:hint="@string/auth_new_password_hint"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    <TextView
        android:id="@+id/tvNewPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_error_text_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_error_password_min_length"
        android:textColor="@color/auth_error_red"
        android:textSize="@dimen/auth_error_text_size"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/etNewPassword"
        app:layout_constraintTop_toBottomOf="@id/etNewPassword" />

    <EditText
        android:id="@+id/etConfirmPassword"
        style="@style/AuthEditTextStyle"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/auth_input_between_margin"
        android:autofillHints="newPassword"
        android:hint="@string/auth_confirm_password_hint"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNewPasswordError"
        app:layout_goneMarginTop="@dimen/auth_input_between_margin" />

    <TextView
        android:id="@+id/tvConfirmPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_error_text_top_margin"
        android:includeFontPadding="false"
        android:text="@string/auth_error_confirm_password_mismatch"
        android:textColor="@color/auth_error_red"
        android:textSize="@dimen/auth_error_text_size"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/etConfirmPassword"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginBottom="@dimen/auth_button_bottom_margin"
        android:background="@drawable/bg_auth_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/auth_confirm"
        android:textColor="@color/auth_text_primary"
        android:textSize="@dimen/auth_button_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>